@@ -0,0 +1,351 @@
+//! E1a: can a light-client update run in LEZ's proven (private) mode and
+//! advance a public instance, and what does the sequencer meter for it?
+
+use borsh::BorshDeserialize;
+use lee_core::{
+    execution_state::PublicExecutionContext as Ctx,
+    program::ReceiveInput,
+};
+
+use super::*;
+use crate::{
+    test_utils::{TestPrivateKeys, update_witness},
+    validated_state_diff::ValidatedStateDiff,
+};
+
+#[derive(BorshSerialize, BorshDeserialize)]
+enum LcMsg {
+    Update {
+        instance: Actor,
+        burn: u64,
+        prev: Vec<u8>,
+        next: Vec<u8>,
+    },
+    Advance {
+        prev: Vec<u8>,
+        next: Vec<u8>,
+    },
+}
+
+const GENESIS: &[u8] = b"store-0";
+const NEXT: &[u8] = b"store-1";
+const INSTANCE: AccountId = AccountId::new([42; 32]);
+
+fn lc_id() -> AccountId {
+    AccountId::from_builtin_program(crate::test_methods::lc_spike().id())
+}
+
+fn instance() -> Actor {
+    Actor::new(INSTANCE, lc_id())
+}
+
+fn burn() -> u64 {
+    std::env::var("E1_BURN").ok().and_then(|v| v.parse().ok()).unwrap_or(572_700)
+}
+
+struct Fixture {
+    state: V03State,
+    keys: TestPrivateKeys,
+    account_id: AccountId,
+    pre_account: Account,
+}
+
+impl Fixture {
+    fn new() -> Self {
+        let keys = test_private_account_keys_1();
+        let account_id = AccountId::for_regular_private_account(&keys.npk(), &keys.vpk());
+        let pre_account = Account::funded(100);
+        let mut state = V03State::new()
+            .with_programs([
+                crate::test_methods::lc_spike(),
+                crate::test_methods::scripted(),
+            ])
+            .with_private_account(&keys, &pre_account);
+        state.force_insert_account(
+            INSTANCE,
+            Account::default().with_actor_state(lc_id(), GENESIS.to_vec().into()),
+        );
+        Self {
+            state,
+            keys,
+            account_id,
+            pre_account,
+        }
+    }
+
+    fn prove_from(
+        &self,
+        program: AccountId,
+        catalog: ProgramCatalog,
+        message: &impl BorshSerialize,
+        present: SenderPresentation,
+    ) -> PrivacyPreservingTransaction {
+        let membership_proof = self
+            .state
+            .get_proof_for_commitment(&Commitment::new(&self.account_id, &self.pre_account))
+            .expect("the account's commitment must be in state");
+        let input = ProvingInput {
+            public_context: Ctx::new(vec![instance()], []),
+            private_witnesses: vec![update_witness(
+                &self.keys,
+                self.pre_account.clone(),
+                membership_proof,
+            )],
+            ..proving_input(root(Actor::new(self.account_id, program), message))
+        };
+        let proven = execute_and_prove_with_cross_messages(
+            input,
+            // `Advance` sends nothing back across the boundary.
+            vec![Vec::new()],
+            &catalog,
+            |_| present,
+            |_, _| false,
+            no_seal,
+        )
+        .unwrap();
+        private_tx(proven, vec![], &[])
+    }
+
+    fn prove_update(&self, prev: &[u8], present: SenderPresentation) -> PrivacyPreservingTransaction {
+        self.prove_from(
+            lc_id(),
+            synthetic_program(crate::test_methods::lc_spike()),
+            &LcMsg::Update {
+                instance: instance(),
+                burn: burn(),
+                prev: prev.to_vec(),
+                next: NEXT.to_vec(),
+            },
+            present,
+        )
+    }
+
+    fn instance_store(&self) -> Vec<u8> {
+        self.state
+            .get_account_by_id(INSTANCE)
+            .data
+            .actor_state(lc_id())
+            .as_ref()
+            .to_vec()
+    }
+
+    fn metered(&self, tx: &PrivacyPreservingTransaction) -> Result<ExecutionCharge, LeeError> {
+        ValidatedStateDiff::from_privacy_preserving_transaction_metered(tx, &self.state, 1, 0, 10_000_000)
+            .map(|(_, charge)| charge)
+    }
+}
+
+use crate::validated_state_diff::ExecutionCharge;
+
+/// Cycles the private `Update` handler takes when executed directly, i.e. what
+/// a public execution of the same check would be metered.
+fn private_cycles() -> u64 {
+    let input = ReceiveInput {
+        receiver: Actor::new(AccountId::new([7; 32]), lc_id()),
+        from: None,
+        is_authorized: true,
+        pre_state: ActorState::empty(),
+        message: borsh::to_vec(&LcMsg::Update {
+            instance: instance(),
+            burn: burn(),
+            prev: GENESIS.to_vec(),
+            next: NEXT.to_vec(),
+        })
+        .unwrap(),
+    };
+    let (_, cycles) = crate::test_methods::lc_spike()
+        .handle_message(&input, u64::MAX)
+        .unwrap();
+    cycles
+}
+
+#[test]
+fn e1a_proven_update_advances_the_public_instance() {
+    let mut f = Fixture::new();
+    let t = std::time::Instant::now();
+    let tx = f.prove_update(GENESIS, SenderPresentation::Canonical);
+    let prove_s = t.elapsed().as_secs_f64();
+    let charge = f.metered(&tx).expect("the transaction is well formed");
+    assert!(charge.revert.is_none(), "{:?}", charge.revert);
+    let proof_bytes = borsh::to_vec(&tx.witness_set).unwrap().len();
+    println!(
+        "E1A private_update_cycles={} public_part_cycles={} prove_s={prove_s:.1} witness_set_bytes={proof_bytes} boundary={:?}",
+        private_cycles(),
+        charge.cycles,
+        tx.message.execution.boundary,
+    );
+    f.state
+        .transition_from_privacy_preserving_transaction(&tx, 1, 0)
+        .expect("the proven update settles");
+    assert_eq!(f.instance_store(), NEXT);
+}
+
+#[test]
+fn e1a_blinded_sender_still_authenticates_its_program() {
+    let mut f = Fixture::new();
+    let tx = f.prove_update(GENESIS, SenderPresentation::Blinded([9; 32]));
+    f.state
+        .transition_from_privacy_preserving_transaction(&tx, 1, 0)
+        .expect("a blinded sender of the same program advances the instance");
+    assert_eq!(f.instance_store(), NEXT);
+}
+
+#[test]
+fn e1a_stale_store_is_refused_and_nothing_moves() {
+    let mut f = Fixture::new();
+    let tx = f.prove_update(b"some-other-store", SenderPresentation::Canonical);
+    let err = f.metered(&tx).unwrap_err().to_string();
+    println!("E1A stale refused: {err}");
+    assert!(err.contains("stale store"));
+    assert!(
+        f.state
+            .transition_from_privacy_preserving_transaction(&tx, 1, 0)
+            .is_err()
+    );
+    assert_eq!(f.instance_store(), GENESIS);
+}
+
+#[test]
+fn e1a_advance_from_another_program_is_refused() {
+    let mut f = Fixture::new();
+    // A private actor of `scripted` sends a well-formed `Advance` straight to the instance.
+    let forged = Script::default().send_sync(
+        instance(),
+        &LcMsg::Advance {
+            prev: GENESIS.to_vec(),
+            next: b"forged".to_vec(),
+        },
+    );
+    let tx = f.prove_from(
+        scripted_id(),
+        synthetic_program(crate::test_methods::scripted()),
+        &forged,
+        SenderPresentation::Canonical,
+    );
+    let err = f.metered(&tx).unwrap_err().to_string();
+    println!("E1A forged refused: {err}");
+    assert!(err.contains("advance must come from this program"));
+    assert!(
+        f.state
+            .transition_from_privacy_preserving_transaction(&tx, 1, 0)
+            .is_err()
+    );
+    assert_eq!(f.instance_store(), GENESIS);
+}
+
+#[test]
+fn e1a_replayed_update_is_refused() {
+    let mut f = Fixture::new();
+    let tx = f.prove_update(GENESIS, SenderPresentation::Canonical);
+    f.state
+        .transition_from_privacy_preserving_transaction(&tx, 1, 0)
+        .unwrap();
+    // Same update again (a racing operator's copy): the store has moved.
+    let err = f
+        .state
+        .transition_from_privacy_preserving_transaction(&tx, 2, 0)
+        .unwrap_err();
+    println!("E1A replay err={err}");
+    assert_eq!(f.instance_store(), NEXT);
+}
+
+// ---------------------------------------------------------------------------
+// E1b: a real mainnet sync-committee update (Sextant's core, accelerated blst)
+// run as a private actor. Needs E1B_ELF (guest ELF) and E1B_INPUT (borsh input).
+
+#[derive(BorshSerialize, BorshDeserialize)]
+enum RealMsg {
+    Update { instance: Actor, input: Vec<u8> },
+    Advance { prev: Vec<u8>, next: Vec<u8> },
+}
+
+#[test]
+#[ignore = "needs E1B_ELF, E1B_INPUT and E1B_STORE"]
+fn e1b_real_update_in_proven_mode() {
+    let elf = std::fs::read(std::env::var("E1B_ELF").unwrap()).unwrap();
+    let input = std::fs::read(std::env::var("E1B_INPUT").unwrap()).unwrap();
+    let image_id: ProgramId = risc0_zkvm::compute_image_id(&elf).unwrap().into();
+    let program = Program::new_unchecked(image_id, std::borrow::Cow::Owned(elf));
+    let program_id = AccountId::from_builtin_program(program.id());
+    let instance = Actor::new(INSTANCE, program_id);
+
+    // The instance starts at the store the update builds on (written by the dumper).
+    let store_bytes = std::fs::read(std::env::var("E1B_STORE").unwrap()).unwrap();
+
+    let keys = test_private_account_keys_1();
+    let account_id = AccountId::for_regular_private_account(&keys.npk(), &keys.vpk());
+    let pre_account = Account::funded(100);
+    let mut state = V03State::new()
+        .with_programs([program.clone()])
+        .with_private_account(&keys, &pre_account);
+    state.force_insert_account(
+        INSTANCE,
+        Account::default().with_actor_state(program_id, store_bytes.clone().into()),
+    );
+
+    let message = RealMsg::Update {
+        instance,
+        input: input.clone(),
+    };
+    let private_cycles = {
+        let probe = ReceiveInput {
+            receiver: Actor::new(AccountId::new([7; 32]), program_id),
+            from: None,
+            is_authorized: true,
+            pre_state: ActorState::empty(),
+            message: borsh::to_vec(&message).unwrap(),
+        };
+        // Warm-up, then time a public-style execution (what a sequencer would run).
+        let _ = program.handle_message(&probe, u64::MAX).unwrap();
+        let runs = 5;
+        let t = std::time::Instant::now();
+        let mut cycles = 0;
+        for _ in 0..runs {
+            cycles = program.handle_message(&probe, u64::MAX).unwrap().1;
+        }
+        println!(
+            "E1B public_execution_ms={:.0} (mean of {runs}, same update executed directly)",
+            t.elapsed().as_secs_f64() * 1000.0 / f64::from(runs)
+        );
+        cycles
+    };
+
+    let membership_proof = state
+        .get_proof_for_commitment(&Commitment::new(&account_id, &pre_account))
+        .unwrap();
+    let proving = ProvingInput {
+        public_context: Ctx::new(vec![instance], []),
+        private_witnesses: vec![update_witness(&keys, pre_account.clone(), membership_proof)],
+        ..proving_input(root(Actor::new(account_id, program_id), &message))
+    };
+    let t = std::time::Instant::now();
+    let proven = execute_and_prove_with_cross_messages(
+        proving,
+        vec![Vec::new()],
+        &ProgramCatalog::from([(program_id, program.clone())]),
+        |_| SenderPresentation::Blinded([9; 32]),
+        |_, _| false,
+        no_seal,
+    )
+    .unwrap();
+    let prove_s = t.elapsed().as_secs_f64();
+    let tx = private_tx(proven, vec![], &[]);
+    let (_, charge) = ValidatedStateDiff::from_privacy_preserving_transaction_metered(
+        &tx, &state, 1, 0, 10_000_000,
+    )
+    .unwrap();
+    assert!(charge.revert.is_none(), "{:?}", charge.revert);
+    let tx_bytes = borsh::to_vec(&tx).unwrap().len();
+    println!(
+        "E1B private_update_cycles={private_cycles} public_part_cycles={} prove_s={prove_s:.1} tx_bytes={tx_bytes} input_bytes={}",
+        charge.cycles,
+        input.len()
+    );
+    state
+        .transition_from_privacy_preserving_transaction(&tx, 1, 0)
+        .expect("the proven real update settles");
+    assert_ne!(
+        state.get_account_by_id(INSTANCE).data.actor_state(program_id).as_ref(),
+        store_bytes.as_slice()
+    );
+}
