@@ -0,0 +1,50 @@
+//! E1 spike: a light-client-shaped program. A private actor runs the heavy
+//! check (`Update`), then advances the program's public instance actor
+//! (`Advance`), which trusts only messages from its own program and only on
+//! top of the store it currently holds.
+
+use borsh::{BorshDeserialize, BorshSerialize};
+use lee_core::{
+    account::Actor,
+    program::{ReceiveInput, Response},
+};
+
+#[derive(BorshSerialize, BorshDeserialize)]
+pub enum LcMsg {
+    Update {
+        instance: Actor,
+        burn: u64,
+        prev: Vec<u8>,
+        next: Vec<u8>,
+    },
+    Advance {
+        prev: Vec<u8>,
+        next: Vec<u8>,
+    },
+}
+
+fn handle(input: &ReceiveInput) -> Response {
+    match borsh::from_slice::<LcMsg>(&input.message).expect("lc message") {
+        LcMsg::Update {
+            instance,
+            burn,
+            prev,
+            next,
+        } => {
+            // Stand-in for the sync-committee verification.
+            let mut x = 0x9e37_79b9_7f4a_7c15_u64;
+            for i in 0..burn {
+                x = core::hint::black_box(x.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(i));
+            }
+            assert_ne!(x, 1);
+            Response::keep_state().send_sync(instance, &LcMsg::Advance { prev, next })
+        }
+        LcMsg::Advance { prev, next } => {
+            assert!(input.from_own_program(), "advance must come from this program");
+            assert_eq!(input.pre_state.as_ref(), prev.as_slice(), "stale store");
+            Response::set_state(next)
+        }
+    }
+}
+
+lee_core::actor_entrypoint!(raw handle);
