+
+    // -----------------------------------------------------------------------
+    // E1c: a light-client update proven as a private actor, settled through the
+    // block fee path: what the block is charged, and what a racing copy costs.
+
+    #[derive(borsh::BorshSerialize, borsh::BorshDeserialize)]
+    enum LcMsg {
+        Update {
+            instance: Actor,
+            burn: u64,
+            prev: Vec<u8>,
+            next: Vec<u8>,
+        },
+        Advance {
+            prev: Vec<u8>,
+            next: Vec<u8>,
+        },
+    }
+
+    const fn lc_spike() -> Program {
+        Program::new_unchecked(
+            test_methods::LC_SPIKE_ID,
+            Cow::Borrowed(test_methods::LC_SPIKE_ELF),
+        )
+    }
+
+    const E1C_GENESIS: &[u8] = b"store-0";
+    const E1C_NEXT: &[u8] = b"store-1";
+
+    fn e1c_instance() -> Actor {
+        Actor::new(
+            AccountId::new([42; 32]),
+            AccountId::from_builtin_program(lc_spike().id()),
+        )
+    }
+
+    fn e1c_state(seeds: &[u8]) -> (V03State, Vec<(TestPrivateKeys, lee::Account)>) {
+        let (state, senders) = private_sender_state(seeds);
+        let mut state = state.with_programs(vec![lc_spike()]);
+        let instance = e1c_instance();
+        state.force_insert_account(
+            instance.account_id,
+            lee::Account::default()
+                .with_actor_state(instance.program_account_id, E1C_GENESIS.to_vec().into()),
+        );
+        (state, senders)
+    }
+
+    fn e1c_update_tx(
+        state: &V03State,
+        (keys, funded): &(TestPrivateKeys, lee::Account),
+        fee: lee_core::FeeTransfer,
+    ) -> LeeTransaction {
+        let instance = e1c_instance();
+        let public_actors = vec![
+            instance,
+            Actor::native_balance(system_accounts::fee_inbox_account_id()),
+        ];
+        let public_actor_states = public_actors
+            .iter()
+            .map(|actor| {
+                (
+                    *actor,
+                    state
+                        .get_account_by_id(actor.account_id)
+                        .data
+                        .actor_state(actor.program_account_id)
+                        .clone(),
+                )
+            })
+            .collect();
+        let membership_proof = state
+            .get_proof_for_commitment(&lee_core::Commitment::new(&keys.account_id(), funded))
+            .expect("the sender's commitment is in state");
+        let burn = std::env::var("E1_BURN")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(572_700);
+        let (output, proof) = lee::execute_and_prove(
+            lee::ProvingInput {
+                root: TransactionEntry::Sync(RootCall {
+                    to: Actor::new(keys.account_id(), instance.program_account_id),
+                    message: borsh::to_vec(&LcMsg::Update {
+                        instance,
+                        burn,
+                        prev: E1C_GENESIS.to_vec(),
+                        next: E1C_NEXT.to_vec(),
+                    })
+                    .unwrap(),
+                }),
+                claims: Vec::new(),
+                fee: Some(fee),
+                public_context: lee::PublicExecutionContext::new(public_actors, []),
+                private_witnesses: vec![update_witness(keys, funded.clone(), membership_proof)],
+                dummy_inputs: Vec::new(),
+                ciphertext_padding: None,
+                recoveries: vec![RecipientEncryption {
+                    recipient: Recipient {
+                        npk: keys.npk(),
+                        vpk: keys.vpk(),
+                        kind: PrivateAccountKind::Regular,
+                        opening: Some(ALIAS_OPENING),
+                    },
+                    esk: EphemeralSecretKey([1; 32]),
+                }],
+                private_promotions: BTreeSet::new(),
+            },
+            &lee::Simulation {
+                public_actor_states,
+                admitted_accounts: None,
+            },
+            &ProgramCatalog {
+                programs: HashMap::from([(
+                    instance.program_account_id,
+                    Dependency {
+                        program: lc_spike(),
+                        kind: ProgramKind::Disclosed,
+                    },
+                )]),
+            },
+            |_| SenderPresentation::Blinded(ALIAS_OPENING),
+            |_, _| false,
+            no_seal,
+        )
+        .expect("the update proves");
+        let message = lee::privacy_preserving_transaction::Message::from_circuit_output(
+            BTreeMap::new(),
+            output,
+        );
+        LeeTransaction::PrivacyPreserving(lee::PrivacyPreservingTransaction::new(
+            message,
+            lee::privacy_preserving_transaction::WitnessSet::from_raw_parts(vec![], proof),
+        ))
+    }
+
+    fn e1c_instance_store(state: &V03State) -> Vec<u8> {
+        let instance = e1c_instance();
+        state
+            .get_account_by_id(instance.account_id)
+            .data
+            .actor_state(instance.program_account_id)
+            .as_ref()
+            .to_vec()
+    }
+
+    #[test]
+    fn e1c_proven_update_settles_through_the_block_fee_path() {
+        let (state, senders) = e1c_state(&[0x61]);
+        let sender = &senders[0];
+        // Reserve for up to 50k public cycles; the surplus is refunded.
+        let reserve = fee_core::assess::private_fee_required(50_000, 8, 8);
+        let tx = e1c_update_tx(&state, sender, inbox_fee(reserve, sender.0.account_id()));
+        let tx_bytes = borsh::to_vec(&tx).unwrap().len();
+        let mut settled = state;
+        let mut summary = BlockFeeSummary::default();
+        let (_, reverted) = settle_transaction(
+            &tx,
+            &mut settled,
+            &FeeState::genesis(),
+            1,
+            100,
+            0,
+            &mut summary,
+        )
+        .expect("the proven update settles");
+        assert!(!reverted);
+        assert_eq!(e1c_instance_store(&settled), E1C_NEXT);
+        let public_cycles = summary.gas_used_exec - fee_core::market::PRIVATE_VERIFY_GAS;
+        println!(
+            "E1C settled gas_used_exec={} (verify {} + public {public_cycles}) gas_used_stor={} \
+             base_fee_paid={} tx_bytes={tx_bytes} block_exec_share={:.2}% block_stor_share={:.2}%",
+            summary.gas_used_exec,
+            fee_core::market::PRIVATE_VERIFY_GAS,
+            summary.gas_used_stor,
+            summary.revenue_base,
+            100.0 * summary.gas_used_exec as f64 / fee_core::market::MAX_GAS_EXEC as f64,
+            100.0 * summary.gas_used_stor as f64 / fee_core::market::MAX_GAS_STOR as f64,
+        );
+        assert_eq!(summary.gas_used_stor, fee_core::market::PRIVATE_GAS_STOR);
+    }
+
+    #[test]
+    fn e1c_a_racing_copy_reverts_and_is_charged() {
+        let (state, senders) = e1c_state(&[0x62, 0x63]);
+        let reserve = fee_core::assess::private_fee_required(50_000, 8, 8);
+        // Two operators prove the same update against the same store.
+        let first = e1c_update_tx(&state, &senders[0], inbox_fee(reserve, senders[0].0.account_id()));
+        let second = e1c_update_tx(&state, &senders[1], inbox_fee(reserve, senders[1].0.account_id()));
+        let mut settled = state;
+        let mut summary = BlockFeeSummary::default();
+        let (_, reverted) =
+            settle_transaction(&first, &mut settled, &FeeState::genesis(), 1, 100, 0, &mut summary)
+                .expect("the first update settles");
+        assert!(!reverted);
+        let before = summary.revenue_base;
+        let (_, reverted) =
+            settle_transaction(&second, &mut settled, &FeeState::genesis(), 1, 100, 1, &mut summary)
+                .expect("the racing copy is included, as a revert");
+        assert!(reverted, "the store moved, so the copy's public part fails");
+        assert_eq!(e1c_instance_store(&settled), E1C_NEXT);
+        println!(
+            "E1C racing copy reverted, charged base_fee={} (the winner paid {before})",
+            summary.revenue_base - before
+        );
+    }
 }
